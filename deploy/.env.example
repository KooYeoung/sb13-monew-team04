# EC2 서버 안에서만 사용하는 운영 환경 변수 템플릿이다.
# 이 파일 자체를 쓰는 게 아니라, EC2 서버에 SSH로 접속해서
#   cp .env.example .env.prod
# 로 복사한 뒤 실제 값을 채워 넣는다. .env.prod는 절대 Git에 올리지 않는다.
# (GitHub Actions는 이 파일을 만들거나 건드리지 않는다. 서버에 한 번 만들어두면
#  배포 때마다 docker compose가 그대로 읽어서 쓴다.)

# --- 서버 기본 ---
MONEW_SERVER_PORT=8080
# boxbox.kr 도메인 + certbot HTTPS까지 적용되어 있다. (Swagger UI의 서버 URL 표기 등에 쓰인다)
MONEW_OPENAPI_SERVER_URL=https://boxbox.kr

# --- DB ---
# compose.prod.yaml에서 postgres 컨테이너의 서비스명이 'postgres'이므로 호스트명도 postgres로 둔다.
MONEW_DB_HOST=postgres
MONEW_DB_PORT=5432
MONEW_DB_NAME=monew
MONEW_DB_USERNAME=monew
MONEW_DB_PASSWORD=<강한-비밀번호로-교체>

# application-prod.yaml 기준: ddl-auto는 validate로 고정 권장.
# 스키마 변경은 Flyway 마이그레이션으로만 하고, Hibernate가 스키마를 직접 바꾸지 않게 한다.
MONEW_JPA_DDL_AUTO=validate
MONEW_FLYWAY_ENABLED=true

# --- NAVER 뉴스 검색 API ---
MONEW_NAVER_CLIENT_ID=<발급받은-client-id>
MONEW_NAVER_CLIENT_SECRET=<발급받은-client-secret>
MONEW_NAVER_CONNECT_TIMEOUT=3s
MONEW_NAVER_READ_TIMEOUT=5s

MONEW_RSS_CONNECT_TIMEOUT=3s
MONEW_RSS_READ_TIMEOUT=5s

# --- S3 (기사 백업) ---
MONEW_AWS_REGION=ap-northeast-2
MONEW_AWS_ENDPOINT=
MONEW_ARTICLE_BACKUP_ENABLED=false
MONEW_ARTICLE_BACKUP_CRON=0 10 0 * * *
MONEW_ARTICLE_BACKUP_S3_BUCKET=
MONEW_ARTICLE_BACKUP_S3_PREFIX=article-backups

# --- 스케줄러 ---
MONEW_ARTICLE_COLLECT_ENABLED=false
MONEW_ARTICLE_COLLECT_CRON=0 0/10 * * * *
MONEW_NOTIFICATION_DELETE_ENABLED=false
MONEW_NOTIFICATION_DELETE_CRON=0 0 0 * * *
