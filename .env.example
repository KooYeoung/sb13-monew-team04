# 이 파일을 .env.dev로 복사한 뒤, 개인 로컬 환경에 맞게 값을 채웁니다.
# .env.dev에는 실제 비밀번호 같은 개인 설정이 들어가므로 Git에 올리지 않습니다.

MONEW_SERVER_PORT=8080
MONEW_OPENAPI_SERVER_URL=https://your-domain.example.com

MONEW_NAVER_CLIENT_ID=
MONEW_NAVER_CLIENT_SECRET=
MONEW_NAVER_CONNECT_TIMEOUT=3s
MONEW_NAVER_READ_TIMEOUT=5s

MONEW_DB_HOST=localhost
# 다른 checkout 또는 기존 DB와 동시에 실행할 때는 사용하지 않는 포트로 변경합니다.
MONEW_DB_PORT=5432
MONEW_DB_NAME=monew
MONEW_DB_USERNAME=monew
MONEW_DB_PASSWORD=change-me

MONEW_JPA_DDL_AUTO=validate
MONEW_JPA_FORMAT_SQL=true
MONEW_JPA_SHOW_SQL=false
MONEW_FLYWAY_ENABLED=true
MONEW_DOCKER_COMPOSE_ENABLED=true
